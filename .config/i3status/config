general {
    output_format = "i3bar"
    colors = true
    color_good = "#7fb4ca"
    color_degraded = "#d27e99"
    color_bad = "#ff5d62"
}

order += "ethernet enp34s0"
order += "cpu_temperatur 0"
order += "memory"
order += "tztime local"
order += "tztime berlin"

tztime local {
    format = "%Y-%m-%d %H:%M:%S"
    hide_if_equals_localtime = true
}

tztime berlin {
    format = "%Y-%m-%d %H:%M:%S"
    timezone = "Europe/Berlin"
}

ethernet enp34s0 {
    format_up = "E: %ip (%speed)"
    format_down = "E: down"
}

cpu_temperature 0 {
    format = "T: %degrees °C"
    path = "/sys/devices/platform/coretemp.0/temp1_input"
}

memory {
    format = "%used"
    threshold_degraded = "10%"
    format_degraded = "MEMORY: %free"
}

read_file uptime {
    path = "/proc/uptime"
}
